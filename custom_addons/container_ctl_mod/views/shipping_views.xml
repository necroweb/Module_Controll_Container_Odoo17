<odoo>
    <!-- ===================================== -->
    <!-- 1. VISTAS: SHIPPING.COMPANY (NAVIERA) -->
    <!-- ===================================== -->
    <!-- Vista lista de navieras -->
    <record id="view_shipping_company_tree" model="ir.ui.view">
        <field name="name">shipping.company.tree</field>
        <field name="model">shipping.company</field>
        <field name="arch" type="xml">
            <tree string="Navieras">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <!-- Vista formulario de navieras -->
    <record id="view_shipping_company_form" model="ir.ui.view">
        <field name="name">shipping.company.form</field>
        <field name="model">shipping.company</field>
        <field name="arch" type="xml">
            <!-- formulario de navieras -->
            <form string="Naviera">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Nombre de la naviera"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Tarifas">
                            <field name="tariff_ids" mode="tree,form">
                                <tree>
                                    <field name="name"/> 
                                    <field name="container_type"/>
                                    <field name="vigencia" readonly="1"/>
                                    <field name="free_days" readonly="1"/>
                                </tree>

                                <form string="Tarifa">
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="container_type"/>
                                            <field name="date_from"/>
                                            <field name="date_to"/>
                                            <field name="vigencia" readonly="1"/>
                                            <field name="free_days" readonly="1"/>
                                        </group>

                                        <notebook>
                                            <page string="Tramos">
                                                <field name="tariff_range_ids">
                                                    <tree editable="bottom">
                                                        <field name="sequence"
                                                               widget="handle"/>
                                                        <field name="day_start"/>
                                                        <field name="day_end"/>
                                                        <field name="price_usd"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ===================================== -->
    <!-- 2. VISTAS: SHIPPING.TARIFF (TARIFAS)  -->
    <!-- ===================================== -->
    <!-- Vista lista de tarifas -->
    <record id="view_shipping_tariff_form" model="ir.ui.view">
        <field name="name">shipping.tariff.form</field>
        <field name="model">shipping.tariff</field>
        <field name="arch" type="xml">
            <form string="Tarifa">
                <sheet>
                    <group>
                        <group string="Información General">
                            <field name="shipping_id"/>
                            <field name="container_type"/>
                        </group>
                        <group string="Vigencia">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="vigencia" readonly="1"/>
                        </group>
                        <group>
                            <field name="free_days" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tramos">
                            <field name="tariff_range_ids">
                                <tree editable="bottom">
                                    <field name="sequence"
                                       widget="handle"/>
                                    <field name="day_start"/>
                                    <field name="day_end"/>
                                    <field name="price_usd"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ===================================== -->
    <!-- 3. VISTAS: SHIPPING.TARIFF.RANGE      -->
    <!-- ===================================== -->
    <!-- Vista lista de tramos -->
    <record id="view_shipping_tariff_range_tree" model="ir.ui.view">
        <field name="name">shipping.tariff.range.tree</field>
        <field name="model">shipping.tariff.range</field>
        <field name="arch" type="xml">
            <tree string="Tramos de tarifa">
                <field name="tariff_id"/>
                <field name="sequence"/>
                <field name="day_start"/>
                <field name="day_end"/>
            </tree>
        </field>
    </record>
    <!-- Vista formulario de tramos -->
    <record id="view_shipping_tariff_range_form" model="ir.ui.view">
        <field name="name">shipping.tariff.range.form</field>
        <field name="model">shipping.tariff.range</field>
        <field name="arch" type="xml">
            <form string="Tramo de tarifa">
                <sheet>
                    <group>
                        <field name="tariff_id"/>
                        <field name="sequence"/>
                    </group>
                    <group string="Rango de días">
                        <field name="day_start"/>
                        <field name="day_end"/>
                        <field name="price_usd"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ===================================== -->
    <!-- 4. ACCIONES                           -->
    <!-- ===================================== -->
    <record id="action_shipping_company" model="ir.actions.act_window">
        <field name="name">Navieras</field>
        <field name="res_model">shipping.company</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_shipping_tariff" model="ir.actions.act_window">
        <field name="name">Tarifas</field>
        <field name="res_model">shipping.tariff</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_shipping_tariff_range" model="ir.actions.act_window">
        <field name="name">Tramos de tarifa</field>
        <field name="res_model">shipping.tariff.range</field>
        <field name="view_mode">tree,form</field>
    </record>
    <!-- ===================================== -->
    <!-- 5. MENÚS                              -->
    <!-- ===================================== -->
    <menuitem
        id="menu_container_root"
        name="Gestión de Contenedores"
        sequence="10"/>
    <menuitem
        id="menu_shipping_company"
        name="Navieras"
        parent="menu_container_root"
        action="action_shipping_company"
        sequence="10"/>
    <menuitem
        id="menu_shipping_tariff"
        name="Tarifas"
        parent="menu_container_root"
        action="action_shipping_tariff"
        sequence="20"/>
    <menuitem
        id="menu_shipping_tariff_range"
        name="Tramos de tarifa"
        parent="menu_container_root"
        action="action_shipping_tariff_range"
        sequence="30"/>
</odoo>
